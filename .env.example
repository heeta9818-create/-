# Supabase를 붙일 때만 채우면 된다.
# 비워두면 앱은 로그인 없이 고정된 개발용 계정으로 돌고,
# 데이터는 로컬 파일(.data/sites.json)에 저장된다.
#
# Supabase 대시보드 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 로그인 버튼 노출 여부.
# Supabase 대시보드에서 Kakao 프로바이더를 설정한 뒤에만 true로 둘 것.
NEXT_PUBLIC_KAKAO_LOGIN=false

# 프로덕션 빌드를 Supabase 없이(=로그인 없이) 로컬에서 확인할 때만 쓴다.
# 실제 배포 환경에는 절대 넣지 말 것.
# ALLOW_INSECURE_DEV_AUTH=true
